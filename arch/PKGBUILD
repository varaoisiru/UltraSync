# Maintainer: Justin Meyers <varaoisiru@users.noreply.github.com>
pkgname=ultrasync
pkgver=2.0.0
pkgrel=1
pkgdesc="Unified news, weather, solar and space dashboard (GUI + TUI), merged from Ultrareader and SolarSync"
arch=('any')
url="https://github.com/varaoisiru/Ultrareader"
license=('MIT')
depends=('python' 'python-fastapi' 'python-uvicorn')
makedepends=('python-build' 'python-installer')
optdepends=('lynx: enhanced article text extraction fallback')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
}

build() {
    cd "$pkgname-$pkgver"
    python -m compileall -q ultrasync
}

package() {
    cd "$pkgname-$pkgver"
    # Application payload
    install -dm755 "$pkgdir/usr/share/$pkgname"
    cp -r ultrasync app_entry.py requirements.txt "$pkgdir/usr/share/$pkgname/"
    find "$pkgdir/usr/share/$pkgname" -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
    # Launcher
    install -Dm755 arch/ultrasync.sh "$pkgdir/usr/bin/$pkgname"
    # systemd --user unit
    install -Dm644 arch/ultrasync.service "$pkgdir/usr/lib/systemd/user/ultrasync.service"
    # Docs
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 arch/README-ARCH.md "$pkgdir/usr/share/doc/$pkgname/README-ARCH.md"
}
